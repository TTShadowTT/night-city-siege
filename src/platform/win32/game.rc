#include <windows.h>

/* the exe's icon and the name Windows shows for it (Task Manager, file properties).
   Paths are relative to the repository root, where build.ps1 runs windres.
   The pictures (ids 2-12) are added by build.ps1 when assets/pictures has them. */
1 ICON "assets/icons/night-city-siege.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TTShadowTT"
            VALUE "FileDescription",  "Night City Siege"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "NightCitySiege"
            VALUE "LegalCopyright",   "TTShadowTT"
            VALUE "OriginalFilename", "Night City Siege.exe"
            VALUE "ProductName",      "Night City Siege"
            VALUE "ProductVersion",   "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
